# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# oh-my-claudecode runtime state; project-scoped skills are the committable exception.
/.omc/*
!/.omc/skills/

# Claude Code per-user settings (.claude/settings.json is shared and committed).
.claude/settings.local.json

# Secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# harness 실행 로그 — 재생성 가능, 커밋하지 않는다.
phases/**/step*-output.json

# Claude Code가 만드는 linked worktree — 런타임 상태, 커밋하지 않는다.
.claude/worktrees/
